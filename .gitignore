# Independent agent/infrastructure repositories and runtime files are not vendored.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/agents.json
!/WORKSPACE-SUMMARY.md
!/PROJECT-ARCHITECTURE.md
!/instructions/
!/packages/
!/.pi/
/.pi/*
!/.pi/skills/
!/tools/
!/tests/
!/.githooks/
# pi-harness2 run artifacts: reports/proposals untracked, only the journal is tracked
!/harness2/
/harness2/*
!/harness2/journal.jsonl
/harness2/report-*
**/__pycache__/
*.pyc
