{
  "name": "pi-memory-distiller",
  "version": "0.1.0",
  "description": "Memory-distiller extension for pi — distills session compaction observations and worker records into append-only knowledge-base atoms (sa52 P1a / Theme B1).",
  "type": "module",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "manual-load-check": "node scripts/manual-load-check.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5"
  }
}
